{
    "id": "goalflowz",
    "name": "GoalFlowz",
    "version": "1.0.0",
    "minAppVersion": "0.15.0",
    "description": "Plugin pour la gestion et le suivi d'objectifs dans Obsidian",
    "author": "Votre Nom",
    "isDesktopOnly": false,
    "commands": [
        {
            "id": "open-goalflowz",
            "name": "Ouvrir GoalFlowz",
            "hotkeys": [
                {
                    "modifiers": ["Ctrl", "Shift"],
                    "key": "O"
                }
            ]
        },
        {
            "id": "open-fullscreen-view",
            "name": "Ouvrir la vue plein écran",
            "hotkeys": [
                {
                    "modifiers": ["Ctrl"],
                    "key": "M"
                }
            ]
        },
        {
            "id": "start-auto-reading",
            "name": "Démarrer la lecture automatique",
            "hotkeys": [
                {
                    "modifiers": ["Ctrl", "Shift"],
                    "key": "P"
                }
            ]
        }
    ]
} 