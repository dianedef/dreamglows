{
  "dependencies": {
    "dockview-core": "^2.1.4",
    "marked": "^15.0.4",
    "pinia": "^2.3.0",
    "pinia-plugin-persistedstate": "^4.2.0",
    "rxjs": "^7.8.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "webextension-polyfill": "^0.12.0"
  },
  "name": "dreamglows-extension",
  "displayName": "DreamGlows Extension",
  "description": "DreamGlows vue3",
  "devDependencies": {
    "@antfu/eslint-config": "^3.12.1",
    "@crxjs/vite-plugin": "2.0.0-beta.28",
    "@iconify-json/fa-solid": "^1.2.1",
    "@iconify-json/heroicons": "^1.2.2",
    "@iconify-json/heroicons-outline": "^1.2.1",
    "@iconify-json/mdi": "^1.2.2",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.10.3",
    "@types/webextension-polyfill": "^0.12.1",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^12.2.0",
    "autoprefixer": "^10.4.20",
    "chrome-types": "^0.1.327",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "daisyui": "^4.12.23",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^22.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "sass": "^1.83.0",
    "tailwindcss": "^3.4.17",
    "terser": "^5.37.0",
    "typescript": "^5.7.2",
    "unplugin-auto-import": "^0.18.6",
    "unplugin-icons": "^0.20.2",
    "unplugin-vue-components": "^0.27.5",
    "unplugin-vue-router": "^0.10.9",
    "vite": "^5.4.11",
    "vite-plugin-pages": "^0.32.4",
    "vite-plugin-vue-devtools": "^7.6.8",
    "vitest": "^0.34.6",
    "vue-tsc": "^2.2.0",
    "web-ext": "^8.3.0",
    "webext-bridge": "^6.0.1"
  },
  "overrides": {
    "@crxjs/vite-plugin": "$@crxjs/vite-plugin"
  },
  "pnpm": {
    "overrides": {},
    "peerDependencyRules": {
      "allowAny": [],
      "allowedVersions": {},
      "ignoreMissing": []
    }
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/dianedef/dreamglows"
  },
  "scripts": {
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "vite build -c vite.chrome.config.ts",
    "build:firefox": "vite build -c vite.firefox.config.ts",
    "dev": "concurrently \"npm run dev:chrome\" \"npm run dev:firefox\"",
    "dev:chrome": "vite -c vite.chrome.config.ts",
    "dev:firefox": "vite build --mode development --watch -c vite.firefox.config.ts",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "lint:manifest": "web-ext lint --pretty",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "type": "module",
  "version": "0.0.1"
}
