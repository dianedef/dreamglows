{
  "name": "goalflowz",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "obsidian_plugin",
    "chrome_extension",
    "windows_app",
    "android_app"
  ],
  "scripts": {
    "dev": "pnpm -r --if-present dev",
    "build": "pnpm -r --if-present build",
    "dev:obsidian-plugin": "pnpm --filter obsidian-goalflowz dev",
    "build:obsidian-plugin": "pnpm --filter obsidian-goalflowz build"
  }
}
