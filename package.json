{
  "name": "dreamglows",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "website",
    "obsidian_plugin",
    "chrome_extension",
    "android_app"
  ],
  "scripts": {
    "dev": "pnpm -r --if-present dev",
    "build": "pnpm -r --if-present build",
    "dev:website": "pnpm --filter dreamglows-website dev",
    "build:website": "pnpm --filter dreamglows-website build",
    "dev:chrome-extension": "pnpm --filter dreamglows-extension dev",
    "build:chrome-extension": "pnpm --filter dreamglows-extension build",
    "dev:obsidian-plugin": "pnpm --filter obsidian-dreamglows dev",
    "build:obsidian-plugin": "pnpm --filter obsidian-dreamglows build"
  }
}
